# gorong-app/.env.example  →  복사해서 gorong-app/.env 로 만든 뒤 값을 채우세요.

# 백엔드 주소: 폰은 localhost 로 PC 에 접속할 수 없습니다.
# PC 의 로컬 IP 를 넣고, PC 와 폰은 같은 Wi-Fi 에 연결하세요. (끝에 /api/v1 포함)
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080/api/v1

# ── Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) → SDK 설정 ──
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Kakao Developers → 앱 키 → JavaScript 키 (지도를 WebView 에서 JS SDK 로 사용) ──
EXPO_PUBLIC_KAKAO_MAP_KEY=

# ── OpenWeatherMap (선택: 백엔드 날씨 호출 실패 시 폴백) ──
EXPO_PUBLIC_WEATHER_API_KEY=
