# gorong-back/.env.example  →  복사해서 gorong-back/.env 로 만든 뒤 값을 채우세요.
# (.env 는 git 에 올라가지 않습니다)

# ── 로컬 DB (docker compose 기본값과 동일. 그대로 써도 됩니다) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gorong_db
DB_USERNAME=gorong
DB_PASSWORD=gorong1234

# ── 공공데이터포털(data.go.kr): 한국관광공사 국문 관광정보 서비스(KorService1) 활용신청 ──
TOUR_API_KEY=

# ── 도로명주소 개발자센터(business.juso.go.kr): 검색 API / 좌표제공 API 각각 신청 ──
JUSO_API_KEY=
JUSO_COORD_API_KEY=

# ── Google AI Studio(https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── OpenWeatherMap(https://openweathermap.org/api) : 선택 ──
WEATHER_API_KEY=

# ── 이미지 업로드 저장소 ──
# 폰(Expo Go)에서도 이미지가 보이려면 PC 의 로컬 IP 를 넣으세요. 예: http://192.168.0.10:8080
APP_STORAGE_BASE_URL=http://localhost:8080
APP_STORAGE_LOCAL_DIR=./uploads

# ── 최초 1회 테이블 생성용(update). 생성 후에는 none 으로 되돌리세요 ──
JPA_DDL_AUTO=none
